        "choices": [
            {
                "option": "Accept the duel. (Risk: Worker Health; Potential: Money, Reputation)",
                "condition": "Combat",
                "message_success": "[acting_worker] meets the knight blow for blow; honor satisfied, the challenger grants half the purse and raises a toast to your house ({actual_money}, {actual_reputation} reputation). (+5 Joy)",
                "message_failure": "Steel rings and the knight presses the edge—[acting_worker] bows out, and you cover the costs with a strained smile ({actual_money}, {actual_reputation} reputation). (-10 Health, -5 Joy)",
                "effect": {
                    "success": { "money": 250, "reputation": 10, "joy": 5 },
                    "failure": { "money": -50, "reputation": -5, "health": -10, "joy": -5 }
                }
            },
            {
                "option": "Decline, but offer the knight free drinks.",

    show black as yvara_bg_dim:
        alpha 0.15
    narrator "Night. The Academy is empty."
    narrator "Your boots echo in the corridor. Every classroom dark, every door closed."
    narrator "A single lamp burns in her office. The light slides under the door like a held breath."
    narrator "She asked you to come. The note was three words: 'Tonight. My office.'"
    narrator "You push the door open."
    narrator "She is at her desk. The lamp casts her shadow long against the bookshelves."

    if yvara_is_devotion_route():
        jump yvara_s5_gate_devotion
    else:
        jump yvara_s5_gate_dominion


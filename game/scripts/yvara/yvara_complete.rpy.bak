    if renpy.loadable(_yvara_emote):
        show expression _yvara_emote as yvara_bust:
            xpos 1.03
            ypos 1.0
            xanchor 1.0
            yanchor 1.0
            yoffset 40
    yvara "Where did you find this?"
    narrator "She takes it carefully, opens it to a middle page, and reads a sentence in silence."
    yvara "I searched for this text for two years. I thought the only copy was in the capital."
    yvara "How did you know I wanted it?"
    narrator "She seems genuinely moved."
    jump yvara_visit_menu

label yvara_gift_fine_wine:
    yvara "A decent vintage."
    narrator "She holds the bottle at eye level for a moment, reading the label."
    yvara "Southern hills. Good year."
    yvara "You have some taste. I had not expected that."
    narrator "She seems to like it, even if she keeps her tone controlled."
    jump yvara_visit_menu

label yvara_gift_herbal_tea:
    yvara "Tea."
    narrator "She is quiet for a moment."
    yvara "Mountain blend. I have not had this one in years."
    yvara "It is oddly... considerate."
    narrator "She sets it beside her papers without looking up again."
    narrator "The reaction is subtle, but warm."
    jump yvara_visit_menu

label yvara_gift_flowers:
    narrator "She takes the bouquet without speaking. Sets it on the desk."
    $ _yvara_emote = "images/yvara/yvara_formal_amused.png"
    if renpy.loadable(_yvara_emote):
        show expression _yvara_emote as yvara_bust:
            xpos 1.03
            ypos 1.0
            xanchor 1.0
            yanchor 1.0
            yoffset 40
    yvara "They suit the light in here, I suppose."
    narrator "She does not look at you, but the corner of her mouth moves."
    narrator "She seems pleased, though she does not quite admit it."
    jump yvara_visit_menu

label yvara_gift_chocolates:
    yvara "Sweets."
    yvara "You do not strike me as someone who gives sweets."
    yvara "...Thank you, all the same."
    narrator "A small but very real reaction."
    jump yvara_visit_menu

label yvara_gift_gem:
    yvara "This is worth real money."
    yvara "I do not collect stones, and I would not know what to do with it."
    yvara "I appreciate the gesture. The choice was... impersonal."
    narrator "She values the gesture, but it feels impersonal to her."
    jump yvara_visit_menu

label yvara_gift_elixir:
    yvara "..."
    narrator "She looks at the bottle. Looks at you. Sets it down slowly."
    yvara "Get out."
    yvara "Come back tomorrow and we will pretend this did not happen."
    narrator "That was far too soon."
    jump yvara_visit_menu

label yvara_gift_poem:
    $ _yvara_emote = "images/yvara/yvara_formal_moved.png"
    if renpy.loadable(_yvara_emote):
        show expression _yvara_emote as yvara_bust:
            xpos 1.03
            ypos 1.0
            xanchor 1.0
            yanchor 1.0
            yoffset 40
    narrator "She takes the paper. Reads it once. Reads it again."
    yvara "..."
    yvara "You wrote this."
    narrator "It is not a question. She folds it carefully and sets it between the pages of the book on her desk—not to put it aside, but to keep it."
    yvara "I will read it again later."
    narrator "She says it quietly, as though she is telling herself as much as you."
    jump yvara_visit_menu

label yvara_gift_botanical:
    narrator "She opens the pressing to a page at random and studies the specimen for a moment."
    yvara "Verath moss. Properly dried."
    narrator "She looks up."
    yvara "Who chose the specimens?"
    narrator "When you tell her, she looks back at the page."
    yvara "You have better taste than I gave you credit for."
    narrator "She sets it beside the lamp where the light will reach it."
    jump yvara_visit_menu

label yvara_gift_spiked_tea:
    narrator "She accepts the tin without comment. Prepares it in the usual way."
    narrator "A moment passes. She takes a sip."
    yvara "This blend is... different."
    narrator "She takes another."
    yvara "There is something in it I cannot place."
    narrator "She does not put it down."
    yvara "It is not unpleasant."
    narrator "She finishes the cup."
    jump yvara_visit_menu

label yvara_gift_silk_ribbon:
    narrator "She holds it for a moment without speaking, turning it slowly between her fingers."
    yvara "This is a fine quality."
    narrator "She sets it on the corner of her desk rather than to the side."
    yvara "I do not know what to do with it."
    narrator "She does not give it back."
    jump yvara_visit_menu

label yvara_gift_default:
    yvara "This is... something."
    yvara "Thank you."
    narrator "She accepts it politely."
    jump yvara_visit_menu

################################################################################
### YVARA — SUPPORT THE ACADEMY / STAGE 5 / STAGE 6 / ENDINGS
################################################################################

# ── Entry point ──────────────────────────────────────────────────────────────
label yvara_support_academy:
    $ _total_days = calculate_total_days()
    $ _current_tier = yvara_academy_investment_tier

    if _current_tier >= 5:
        narrator "You have already done everything that can be done for the Academy's finances."
        jump yvara_visit_menu

    if _current_tier == 0:
        jump yvara_support_tier_1
    elif _current_tier == 1:
        jump yvara_support_tier_2
    elif _current_tier == 2:
        jump yvara_support_tier_3
    elif _current_tier == 3:
        jump yvara_support_tier_4
    elif _current_tier == 4:
        jump yvara_support_tier_5
    else:
        jump yvara_visit_menu

# ── Tier 1 — 500 coins ──────────────────────────────────────────────────────
label yvara_support_tier_1:
    if money < 500:
        narrator "You do not have enough coin. Five hundred is the minimum that would make a difference."
        jump yvara_visit_menu

    $ money -= 500
    $ yvara_s4_finance_last_day = calculate_total_days()

    if yvara_is_devotion_route():
        $ _emote = "images/yvara/yvara_formal_moved.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust at yvara_bust_right
        narrator "You set five hundred coins on her desk without ceremony."
        narrator "She looks at the money, then at you. Her mouth opens and closes once."
        yvara "This is... for the Academy?"
        narrator "You tell her to cover whatever needs covering."
        yvara "We have minor expenses that have been deferred. Chalk. Binding glue. A cracked lens."
        narrator "She is already sorting the coins into neat stacks. Her hands are steady but her voice is not quite."
        yvara "Thank you."
        narrator "She says it quickly, as though speed will keep it from meaning too much."
        narrator "It does not work."
        $ yvara_devotion += 3
        $ yvara_affection += 4

    else:
        $ _emote = "images/yvara/yvara_formal_neutral.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust at yvara_bust_right
        narrator "You place five hundred coins on her desk along with a receipt you prepared in advance."
        yvara "What is this?"
        narrator "You explain that you are covering a minor outstanding debt. You would appreciate a signature."
        narrator "She reads the receipt twice. Her expression does not change."
        yvara "This is in order."
        narrator "She signs. The pen does not hesitate."
        yvara "I trust this settles the matter."
        narrator "It settles something. Not the matter she means."
        $ yvara_dominion += 3
        $ yvara_affection += 3

    $ yvara_academy_investment_tier = 1
    $ yvara_academy_investment_total += 500
    $ yvara_academy_investments_count += 1
    $ yvara_evening_tier = max(yvara_evening_tier, 2)
    $ yvara_recalculate_stage()
    call yvara_check_stage_advance from _call_yvara_support_1
    jump yvara_visit_menu

# ── Tier 2 — 1,000 coins ────────────────────────────────────────────────────
label yvara_support_tier_2:
    if money < 1000:
        narrator "A thousand coins. You do not have it."
        jump yvara_visit_menu

    $ money -= 1000
    $ yvara_s4_finance_last_day = calculate_total_days()

    if yvara_is_devotion_route():
        $ _emote = "images/yvara/yvara_formal_warm.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You tell her the thousand coins are for student supplies. Books, ink, whatever the classroom needs."
        narrator "She goes still for a moment."
        yvara "You want to see it."
        narrator "It is not a question. She leads you down the corridor to a bright room with high windows and worn desks."
        narrator "Student work is pinned to every wall. Diagrams. Spell notation. One surprisingly good drawing of a cat."
        yvara "This is what you are paying for."
        narrator "There is warmth in her voice that was not there a month ago."
        yvara "I will see that every coin reaches the students."
        narrator "You believe her without question."
        $ yvara_devotion += 4
        $ yvara_affection += 5

    else:
        $ _emote = "images/yvara/yvara_formal_surprised.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You present a thousand coins and a letter from the creditor confirming interest clearance on the Academy's main loan."
        narrator "She takes the letter. Reads it once. Reads it again."
        yvara "You contacted them directly."
        narrator "You tell her you prefer clean bookkeeping."
        yvara "The interest was... considerable. This is not a small gesture."
        narrator "She hands the creditor's letter back to you. Her fingers brush yours."
        yvara "Keep it. You paid for it."
        narrator "The transaction is complete. The ledger is a little more yours."
        $ yvara_dominion += 4
        $ yvara_affection += 4

    $ yvara_academy_investment_tier = 2
    $ yvara_academy_investment_total += 1000
    $ yvara_academy_investments_count += 1
    $ yvara_recalculate_stage()
    call yvara_check_stage_advance from _call_yvara_support_2
    jump yvara_visit_menu

# ── Tier 3 — 2,000 coins ────────────────────────────────────────────────────
label yvara_support_tier_3:
    if money < 2000:
        narrator "Two thousand coins. You cannot manage it right now."
        jump yvara_visit_menu

    $ money -= 2000
    $ yvara_s4_finance_last_day = calculate_total_days()

    if yvara_is_devotion_route():
        $ _emote = "images/yvara/yvara_formal_surprised.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You tell her the two thousand is for equipment. Replacement lenses. New crucibles. Whatever has been held together with wire and hope."
        yvara "How did you know about the crucibles?"
        narrator "You tell her you have been paying attention."
        narrator "Something crosses her face that she cannot quite suppress."
        yvara "I have been requisitioning replacements for two years. The budget never..."
        narrator "She stops. Her composure is intact, but only just."
        yvara "You understand this changes things for the students."
        narrator "She touches the edge of her desk as though steadying herself."
        yvara "Thank you. I mean it in a way I do not usually mean it."
        narrator "She does."
        $ yvara_devotion += 5
        $ yvara_affection += 6

    else:
        $ _emote = "images/yvara/yvara_formal_yielding.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You present the restructured payment terms. Two thousand coins and the Academy's debt now runs through you instead of the original creditor."
        yvara "You restructured the loan."
        narrator "You tell her the terms are better than what she had. Which is true."
        yvara "And my name is on your paperwork now."
        narrator "Also true."
        narrator "She reads every line. She is looking for a trap. There is not one — only a door that opens in one direction."
        yvara "I see."
        narrator "She signs. The composure does not break, but it bends."
        $ yvara_dominion += 5
        $ yvara_affection += 5

    $ yvara_academy_investment_tier = 3
    $ yvara_academy_investment_total += 2000
    $ yvara_academy_investments_count += 1
    $ yvara_evening_tier = max(yvara_evening_tier, 3)
    $ yvara_recalculate_stage()
    call yvara_check_stage_advance from _call_yvara_support_3
    jump yvara_visit_menu

# ── Tier 4 — 3,500 coins ────────────────────────────────────────────────────
label yvara_support_tier_4:
    if money < 3500:
        narrator "Three thousand five hundred coins. Not yet."
        jump yvara_visit_menu

    $ money -= 3500
    $ yvara_s4_finance_last_day = calculate_total_days()

    if yvara_is_devotion_route():
        $ _emote = "images/yvara/yvara_formal_vulnerable.png" if renpy.loadable("images/yvara/yvara_formal_vulnerable.png") else "images/yvara/yvara_formal_moved.png"
        if renpy.loadable(_emote):
            if "yvara_formal_vulnerable.png" in _emote:
                show expression _emote as yvara_bust at yvara_bust_right_half
            else:
                show expression _emote as yvara_bust at yvara_bust_right
        narrator "You tell her you are covering the quarterly shortfall. All of it."
        narrator "She does not speak for a long time."
        yvara "The quarterly..."
        narrator "She opens the ledger. Runs her finger down the column. The numbers confirm what you said."
        yvara "Do you know how many nights I have sat here trying to make these figures work?"
        narrator "You do not answer. She does not need you to."
        narrator "Her eyes are bright. She removes her glasses and presses her fingertips against her eyelids."
        yvara "I am not going to cry in front of you."
        narrator "She is already crying. It lasts only a few seconds. She puts her glasses back on and straightens her collar."
        yvara "That will not happen again."
        narrator "You tell her it can happen as often as it needs to."
        narrator "She looks at you as though you have said something impossible and true."
        $ yvara_devotion += 6
        $ yvara_affection += 8

    else:
        $ _emote = "images/yvara/yvara_formal_neutral.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You place the purchase agreement on her desk. Three thousand five hundred coins for the outstanding note on the Academy's primary debt."
        yvara "You bought the note."
        narrator "You tell her you prefer to hold your investments close."
        yvara "Then the Academy owes its debt to you now. Not to the lender."
        narrator "She says it with the precision of someone who understands exactly what has changed."
        $ _emote2 = "images/yvara/yvara_formal_yielding.png"
        if renpy.loadable(_emote2):
            show expression _emote2 as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "She folds the agreement and places it in the top drawer."
        yvara "I assume you will want terms."
        narrator "You tell her you will think about it."
        narrator "She nods once. The cold dignity does not waver, but something behind it has shifted."
        $ yvara_dominion += 6
        $ yvara_affection += 6

    $ yvara_academy_investment_tier = 4
    $ yvara_academy_investment_total += 3500
    $ yvara_academy_investments_count += 1
    $ yvara_recalculate_stage()
    call yvara_check_stage_advance from _call_yvara_support_4
    jump yvara_visit_menu

# ── Tier 5 — 5,000 coins ────────────────────────────────────────────────────
label yvara_support_tier_5:
    if money < 5000:
        narrator "Five thousand coins. You are not there yet."
        jump yvara_visit_menu

    $ money -= 5000
    $ yvara_s4_finance_last_day = calculate_total_days()

    if yvara_is_devotion_route():
        $ _emote = "images/yvara/yvara_formal_kiss.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You tell her you are endowing a permanent fund. Five thousand coins, invested in perpetuity. The Academy will never face a shortfall again."
        narrator "She stares at the documents as though they are written in a language she has forgotten."
        yvara "A permanent fund."
        narrator "You confirm it. The interest alone will cover operating costs."
        yvara "You are giving me something I have wanted for fifteen years and could never reach."
        narrator "Her voice is steady. Her hands are not."
        yvara "I do not have words for this."
        narrator "She stands. She walks around the desk. She stops in front of you."
        narrator "The kiss is not sudden. It is deliberate and certain and it lasts a long time."
        yvara "The Academy is secure."
        narrator "She says it against your mouth, and she means everything the words contain and everything they do not."
        $ yvara_devotion += 8
        $ yvara_affection += 10

    else:
        $ _emote = "images/yvara/yvara_formal_yielding.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40
        narrator "You present the final document. Full foreclosure of the Academy's ledger. Five thousand coins. Every outstanding obligation consolidated under your name."
        yvara "You own it all."
        narrator "You tell her the Academy will continue to operate exactly as it does. Nothing changes day to day."
        yvara "Except that it runs at your pleasure."
        narrator "She stands and smooths her skirt. The gesture is automatic. Everything else about her is very deliberate."
        yvara "I built this institution from nothing. I have given it everything I have."
        yvara "And now it belongs to you."
        narrator "She holds your gaze. There is no anger. No defeat. Only the cold clarity of someone who has weighed every option and found the scale already tipped."
        yvara "I trust you will be a responsible owner."
        narrator "The word 'owner' lands precisely where she intends it to."
        $ yvara_dominion += 8
        $ yvara_affection += 8

    $ yvara_academy_investment_tier = 5
    $ yvara_academy_investment_total += 5000
    $ yvara_academy_investments_count += 1
    $ yvara_evening_tier = max(yvara_evening_tier, 4)
    $ yvara_recalculate_stage()
    call yvara_check_stage_advance from _call_yvara_support_5
    jump yvara_visit_menu

# ═══════════════════════════════════════════════════════════════════════════════
# STAGE 5 — THE BREAKING POINT
# Talks, remarks, and gate scene.
# Requires: S4 complete, Storm scene done, Support tiers progressed.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Talk Router ──────────────────────────────────────────────────────────────
label yvara_s5_talk_router:
    if "s5_t1" not in yvara_s5_talks_done:
        jump yvara_s5_talk_1
    elif "s5_t2" not in yvara_s5_talks_done:
        jump yvara_s5_talk_2
    elif "s5_t3" not in yvara_s5_talks_done:
        jump yvara_s5_talk_3
    else:
        jump yvara_talk_generic

# ── Talk 1: "The Real Number" ────────────────────────────────────────────────
label yvara_s5_talk_1:
    $ _title = player_title

    if yvara_is_devotion_route():
        $ _emote = "images/yvara/yvara_formal_vulnerable.png"
        if not renpy.loadable(_emote):
            $ _emote = "images/yvara/yvara_formal_moved.png"
        if renpy.loadable(_emote):
            if "yvara_formal_vulnerable.png" in _emote:
                show expression _emote as yvara_bust at yvara_bust_right_half
            else:
                show expression _emote as yvara_bust at yvara_bust_right

        narrator "She is waiting for you with a ledger open on the desk. Not the usual one."
        narrator "This one is thicker. The binding is cracked and the pages are soft with use."
        yvara "Close the door."
        narrator "You do. The latch clicks like a small bone breaking."
        yvara "I have been showing you the summary figures. The version for the board."
        narrator "She turns the ledger toward you. The columns are dense, written in her precise hand."
        yvara "This is the real number."
        narrator "You look. The figure at the bottom of the page is nearly triple what you expected."
        narrator "Her fingers rest on the edge of the book. They are trembling, very slightly."
        yvara "I should have shown you this months ago."
        narrator "She removes her glasses and sets them on the desk. Without them her eyes look larger. Frightened."
        yvara "I was ashamed."
        narrator "The word costs her something visible. A flinch at the corner of her mouth."

        menu:
            "\"You trusted me with this. That is what matters.\"":
                $ yvara_devotion += 5
                $ yvara_affection += 3
                narrator "She exhales. A sound like something unclenching."
                yvara "I do trust you. That is the problem and the answer to it."

            "\"We will fix this. Together.\"":
                $ yvara_devotion += 4
                $ yvara_affection += 3
                narrator "She puts her glasses back on. Her hands are steadier now."
                yvara "Together. I am still learning what that word means."

            "\"How long have you been carrying this alone?\"":
                $ yvara_devotion += 3
                $ yvara_affection += 2
                yvara "Since before you arrived. Years."
                narrator "She says it simply. The weight of it is in the simplicity."

    else:
        $ _emote = "images/yvara/yvara_formal_angry.png"
        if not renpy.loadable(_emote):
            $ _emote = "images/yvara/yvara_formal_neutral.png"
        if renpy.loadable(_emote):
            show expression _emote as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40

        narrator "You tell her you want to see the real ledger. Not the summary. The actual figures."
        narrator "She goes still behind her desk."
        yvara "I do not know what you mean."
        narrator "You tell her you have seen the creditor filings. The numbers do not match what she has shown you."
        narrator "A silence. Her jaw tightens."
        yvara "You went through the public filings."
        narrator "You did. You tell her it was not difficult."

        $ _emote2 = "images/yvara/yvara_formal_yielding.png"
        if renpy.loadable(_emote2):
            show expression _emote2 as yvara_bust:
                xpos 1.03
                ypos 1.0
                xanchor 1.0
                yanchor 1.0
                yoffset 40

        narrator "She opens the bottom drawer. Pulls out the real ledger. Sets it on the desk between you."
        yvara "There. Now you know everything."
        narrator "The figure is enormous. She watches you read it with the rigid calm of someone expecting a blow."

        menu:
            "\"You should have shown me this willingly.\"":
                $ yvara_dominion += 5
                $ yvara_affection += 2
                yvara "Would it have changed your calculations?"
                narrator "You tell her it would have changed your patience."
                narrator "She absorbs that. Files it away behind her careful eyes."

            "\"This changes the terms of our arrangement.\"":
                $ yvara_dominion += 4
                $ yvara_affection += 2
                narrator "She nods once. She expected this."
                yvara "I assumed it would. What do you want?"
                narrator "You tell her you will let her know. The waiting is part of it."

            "\"At least now we are working with real numbers.\"":
                $ yvara_dominion += 3
                $ yvara_affection += 3
                yvara "Real numbers. Yes."
                narrator "She closes the ledger. Her hand rests on its cover like a hand on a coffin lid."

    $ yvara_s5_talks_done.append("s5_t1")
    $ yvara_last_talk_total_days = calculate_total_days()
    $ yvara_recalculate_stage()
    call yvara_check_stage_advance from _call_yvara_s5_t1
    jump yvara_visit_menu

# ── Talk 2: "What It Costs Her" ─────────────────────────────────────────────
label yvara_s5_talk_2:
    $ _title = player_title

    if yvara_is_devotion_route():

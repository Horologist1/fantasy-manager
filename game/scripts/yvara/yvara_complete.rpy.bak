    if renpy.loadable(_emote):
        show expression _emote as yvara_bust:
            xpos 1.03
            ypos 1.0
            xanchor 1.0
            yanchor 1.0
            yoffset 40

    narrator "She is waiting in your office. Standing. Hands folded."

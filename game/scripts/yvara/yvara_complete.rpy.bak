# ── Stage 4: Evening at the Academy (repeatable, tiered) ─────────────────────────
label yvara_evening_academy:
    $ _total_days = calculate_total_days()
    $ yvara_evening_academy_last_day = _total_days
    $ _tier = int(getattr(store, "yvara_evening_tier", 1) or 1)
    $ _is_dev = yvara_is_devotion_route()
    $ _title = (getattr(store, "player_title", "") or "").strip().lower()
    $ _vi = int(getattr(store, "yvara_evening_variant_index", 0) or 0) % 4
    $ store.yvara_evening_variant_index = _vi + 1

    # Background
    $ _academy_bg = "images/buildings/bg_academy_night.png" if renpy.loadable("images/buildings/bg_academy_night.png") else ("images/buildings/academy.png" if renpy.loadable("images/buildings/academy.png") else "images/event_bg.png")
    scene expression _academy_bg at yvara_bg_blur
    hide yvara_bust
    show black as yvara_bg_dim:
        alpha 0.15

    if _is_dev:
        if _tier >= 4:
            jump yvara_evening_dev_t4
        elif _tier >= 3:
            jump yvara_evening_dev_t3
        elif _tier >= 2:
            jump yvara_evening_dev_t2
        else:
            jump yvara_evening_dev_t1
    else:
        if _tier >= 4:
            jump yvara_evening_dom_t4
        elif _tier >= 3:
            jump yvara_evening_dom_t3
        elif _tier >= 2:
            jump yvara_evening_dom_t2
        else:
            jump yvara_evening_dom_t1


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  STAGE 6 — THE ARRANGEMENT                                               ║
# ║                                                                           ║
# ║  Three talks + gate scene + ending resolution.                            ║
# ║  Ending determined by yvara_devotion vs yvara_dominion spread.            ║
# ║                                                                           ║
# ║  INTEGRATION NOTE: yvara_visit_menu (in script.rpy) needs a check at     ║
# ║  the top:                                                                 ║
# ║    if yvara_s6_gate_fired and not getattr(store, "yvara_ending_done", False): ║
# ║        jump yvara_ending_resolution                                       ║
# ╚════════════════════════════════════════════════════════════════════════════╝

init python:
    def yvara_determine_ending():
        dev = int(getattr(store, "yvara_devotion", 0) or 0)
        dom = int(getattr(store, "yvara_dominion", 0) or 0)
        diff = abs(dev - dom)
        if dev > dom and diff >= 10:
            return "devotion"
        elif dom > dev and diff >= 10:
            return "dominion"
        else:
            return "mixed"


# Ignore worker images
game/images/workers/

# Android signing keys / build config — regenerate locally, never commit (contain secrets)
*.keystore
*.jks
android.json
keystore.properties
local.properties

# IDE / AI tooling — not needed in the public repo
.claude/
.cursor/

# Developer maintenance scripts — offline JSON tooling, not needed at runtime
# Anchored to repo root so it does NOT swallow devkit_web/src/tools/ (app source).
/tools/

# Desktop devkit (compiled editor exe) — distributed separately
devkit/

# Stray dev scripts and runtime logs
AGENTS.md
_fix.py
errors.txt
log.txt
claude-*.log
*.log

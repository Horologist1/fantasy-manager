# Ignore worker images
game/images/workers/

# Android signing keys / build config — regenerate locally, never commit (contain secrets)
*.keystore
*.jks
android.json
keystore.properties
local.properties

# IDE / AI tooling — not needed in the public repo
.claude/
.cursor/

# Developer maintenance scripts — offline JSON tooling, not needed at runtime
tools/

# Browser devkit — modding tool, distributed separately
devkit_web/

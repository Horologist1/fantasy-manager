# Ignore explicit images — not hosted on public repos
game/images/workers/
game/images/yvara/

# Android signing keys / build config — regenerate locally, never commit (contain secrets)
*.keystore
*.jks
android.json
keystore.properties
local.properties

# IDE / AI tooling and internal dev docs — not needed in the public repo
.claude/
.cursor/
.hermes/
/docs/*
!/docs/AUDIT_event_verification_2026-09-09.md
!/docs/JSON_OVERRIDES_2026-09-10.md
!/docs/ANDROID_MOD_IMPORT_2026-09-10.md
!/docs/AUDIT_general_2026-09-10.md
!/docs/RENPY_DEVELOPMENT_NOTES.md
!/docs/REVIEW_devkit_architecture_2026-09-10.md
!/docs/DEVKIT_upgrade_2026-09-10.md

# Developer tools (QA harnesses, autoplayer, Android build helpers) — kept in the private repo
/tools/

# Desktop devkit (compiled editor exe) — distributed separately
devkit/

# Stray dev scripts and runtime logs
AGENTS.md
_fix.py
errors.txt
log.txt
traceback.txt
hang-debug.log
temp_original.rpy
dialogue.tab
claude-*.log
*.log

# Revamp repo: bulk art not versioned (files exist on disk, unchanged from original)
game/images/


# Generated by Ren'Py compile/lint - never version in the revamp repo
*.rpyc
*.rpyb
*.rpymc
game/cache/


# UI probe captures (verification artifacts)
ui_probe/


# Verification artifacts and runtime state (not source)
/backups/
ui_probe/
game/saves/
game/tl/None/*.rpymc

# Python bytecode caches (pure python-packages + tests)
__pycache__/
*.pyc

# Playwright MCP screenshots / logs (local QA)
.playwright-mcp/
